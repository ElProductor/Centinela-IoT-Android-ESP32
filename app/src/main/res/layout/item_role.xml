<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="@color/surface"
    app:cardCornerRadius="14dp"
    app:strokeColor="@color/card_stroke"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvRoleName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="OPERATOR"
                android:textColor="@color/primary"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSystemBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/badge_rounded_system"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:text="SISTEMA"
                android:textColor="@color/text_muted"
                android:textSize="10sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <ImageButton
                android:id="@+id/btnDeleteRole"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Eliminar Rol"
                android:src="@android:drawable/ic_menu_delete"
                app:tint="@color/inacap_red" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvRoleDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Descripción de los permisos y alcance del rol en la planta."
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupPermissions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipDisarm"
                style="@style/Widget.Material3.Chip.Assist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔓 Desarme"
                android:textColor="@color/text_primary"
                android:textSize="11sp"
                app:chipBackgroundColor="@color/surface_variant"
                app:chipStrokeColor="@color/card_stroke" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipRemoteOpen"
                style="@style/Widget.Material3.Chip.Assist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🚪 Apertura Remota"
                android:textColor="@color/text_primary"
                android:textSize="11sp"
                app:chipBackgroundColor="@color/surface_variant"
                app:chipStrokeColor="@color/card_stroke" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipUniversalGpio"
                style="@style/Widget.Material3.Chip.Assist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚡ Control GPIO"
                android:textColor="@color/text_primary"
                android:textSize="11sp"
                app:chipBackgroundColor="@color/surface_variant"
                app:chipStrokeColor="@color/card_stroke" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipManageUsers"
                style="@style/Widget.Material3.Chip.Assist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="👥 Crear Roles/Users"
                android:textColor="@color/text_primary"
                android:textSize="11sp"
                app:chipBackgroundColor="@color/surface_variant"
                app:chipStrokeColor="@color/card_stroke" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipViewAudit"
                style="@style/Widget.Material3.Chip.Assist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📋 Ver Auditoría"
                android:textColor="@color/text_primary"
                android:textSize="11sp"
                app:chipBackgroundColor="@color/surface_variant"
                app:chipStrokeColor="@color/card_stroke" />
        </com.google.android.material.chip.ChipGroup>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
